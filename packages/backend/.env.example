# Server Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger

# JWT Security
JWT_SECRET=miniledger-bharat-edition-super-secret-jwt-key-2026
JWT_EXPIRES_IN=30d

# Mock OTP Configuration
OTP_EXPIRY_MINUTES=5
# When true, the API response also includes debugOtp alongside printing it in the server terminal
EXPOSE_MOCK_OTP_IN_RESPONSE=true

# Receipt Image Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5